# Hugging Face Token (opcional, para evitar límites de descarga del modelo CLAP)
HF_TOKEN=your_huggingface_token_here

# Spotify Developer API (necesario para subdividir playlists o extraer canciones)
# Obtén tus credenciales en https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8978/callback
